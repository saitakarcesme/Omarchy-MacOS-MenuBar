{
  "name": "Omarchy-MacOS-MenuBar",
  "slug": "omarchy-macos-menubar",
  "kind": "bar",
  "dependencies": [
    "quickshell",
    "hyprctl",
    "omarchy",
    "python3"
  ],
  "copies": [
    {
      "source": "plugins",
      "destination": ".config/omarchy/plugins"
    }
  ],
  "defaultRight": [
    "macos.tray",
    "omarchy.tailscale",
    "omarchy.agents",
    "omarchy.bluetooth",
    "omarchy.network",
    "omarchy.audio",
    "omarchy.monitor",
    "omarchy.power",
    "omarchy.keyboard-layout",
    "omarchy.system-update",
    "omarchy.clock"
  ],
  "lua": {
    ".config/hypr/looknfeel.lua": "hl.layer_rule({ match = { namespace = \"^(omarchy-bar|omarchy-keyboard-panel)$\" }, blur = true, blur_popups = true, ignore_alpha = 0.2, no_anim = true })"
  }
}
